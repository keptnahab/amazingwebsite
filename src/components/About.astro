---
import { Image } from "astro:assets";
import portrait from "../assets/about/portrait.jpg";
import { t } from "../i18n/config";
---

<section class="section about" id="about">
  <div class="wrap grid">
    <div class="photo reveal" data-spotlight>
      <Image src={portrait} alt="Michael Kühbandner" widths={[420, 680, 900]} sizes="(max-width: 820px) 80vw, 38vw" />
    </div>

    <div class="copy">
      <p class="eyebrow reveal">{t.about.eyebrow}</p>
      <h2 class="section-title reveal">{t.about.title}</h2>
      <hr class="rule reveal" />
      <div class="text reveal">
        <p>
          {t.about.p1Pre}<strong>{t.about.p1Strong}</strong>{t.about.p1Post}
        </p>
        <p>
          {t.about.p2}
        </p>
        <p>
          {t.about.p3Pre}<a href="https://www.360-degree-collective.com" target="_blank" rel="noopener noreferrer">{t.about.p3Link}</a>{t.about.p3Post}
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 0.85fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .photo {
    position: relative;
    border: 1px solid var(--line);
    border-radius: 4px;
    overflow: hidden;
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.04);
    transition: filter 0.6s var(--ease), transform 0.9s var(--ease);
  }
  .photo:hover :global(img) { filter: grayscale(0.55) contrast(1.05); transform: scale(1.03); }

  .text p { color: var(--muted); max-width: 54ch; margin: 0 0 1.1rem; }
  .text strong { color: var(--text); font-weight: 600; }

  @media (max-width: 820px) {
    .grid { grid-template-columns: 1fr; }
    .photo { max-width: 360px; }
  }

  @media (max-width: 760px) {
    .photo { max-width: min(78vw, 420px); margin-inline: auto; }
    /* scroll-wake spotlight replaces :hover — the portrait "develops" into
       color as it crosses screen-center while scrolling */
    .photo.live :global(img) { filter: grayscale(0.55) contrast(1.05); transform: scale(1.02); }
  }
</style>
