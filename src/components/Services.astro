---
import { Image } from "astro:assets";
import collectiveLogo from "../assets/collective/360-degree-collective-logo.png";
import { t } from "../i18n/config";

const oct =
  "59.72,43.49 43.49,59.72 20.51,59.72 4.28,43.49 4.28,20.51 20.51,4.28 43.49,4.28 59.72,20.51";

const colors: Record<string, string> = {
  visual: "var(--r)",
  programming: "var(--g)",
  preproduction: "var(--b)",
};
const cards = t.services.cards.map((c) => ({ ...c, color: colors[c.key] }));
---

<section class="section services" id="services">
  <div class="wrap">
    <p class="eyebrow reveal">{t.services.eyebrow}</p>
    <h2 class="section-title reveal">{t.services.title}</h2>
    <hr class="rule reveal" />

    <div class="cards">
      {cards.map((c) => (
        <article class="card reveal press" data-key={c.key} data-spotlight style={`--c:${c.color}`}>
          <div class="icon">
            <svg viewBox="0 0 64 64" width="56" height="56" aria-hidden="true">
              <polygon points={oct} fill="var(--c)" class="oct" />
              <g class="glyph" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" fill="none">
                {c.key === "visual" && (
                  <>
                    <circle cx="32" cy="32" r="6" fill="#fff" stroke="none" />
                    <line x1="32" y1="12" x2="32" y2="19" />
                    <line x1="32" y1="45" x2="32" y2="52" />
                    <line x1="12" y1="32" x2="19" y2="32" />
                    <line x1="45" y1="32" x2="52" y2="32" />
                    <line x1="18" y1="18" x2="23" y2="23" />
                    <line x1="41" y1="41" x2="46" y2="46" />
                    <line x1="46" y1="18" x2="41" y2="23" />
                    <line x1="23" y1="41" x2="18" y2="46" />
                  </>
                )}
                {c.key === "programming" && (
                  <>
                    <polyline points="26,24 16,32 26,40" />
                    <polyline points="38,24 48,32 38,40" />
                  </>
                )}
                {c.key === "preproduction" && (
                  <>
                    <path d="M32 14 L48 23 L48 41 L32 50 L16 41 L16 23 Z" />
                    <path d="M16 23 L32 32 L48 23" />
                    <line x1="32" y1="32" x2="32" y2="50" />
                  </>
                )}
              </g>
            </svg>
          </div>
          <h3 class="card-title">{c.title}</h3>
          <p class="card-sub">{c.sub}</p>
          <p class="card-text">{c.text}</p>
        </article>
      ))}
    </div>

    <p class="services-note reveal">
      {t.services.note}
    </p>

    <a
      class="network reveal press"
      data-spotlight
      href="https://www.360-degree-collective.com"
      target="_blank"
      rel="noopener noreferrer"
    >
      <div class="network-icon">
        <Image src={collectiveLogo} alt="" width={32} height={32} />
      </div>
      <div class="network-copy">
        <h3 class="network-title">{t.services.networkTitle}</h3>
        <p class="network-text">
          {t.services.networkText}
        </p>
      </div>
    </a>
  </div>
</section>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.1rem;
    margin-top: clamp(2rem, 5vw, 3.2rem);
  }
  .card {
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 2.2rem 1.8rem;
    transition: transform 0.5s var(--ease), border-color 0.5s var(--ease), background 0.5s var(--ease);
  }
  .card:hover {
    transform: translateY(-6px);
    border-color: color-mix(in srgb, var(--c) 55%, var(--line));
    background: var(--bg-3);
  }

  .icon { margin-bottom: 1.5rem; }
  .oct {
    transform-origin: 32px 32px;
    transition: transform 0.6s var(--ease), filter 0.6s var(--ease);
  }
  .glyph { transform-origin: 32px 32px; transition: transform 0.6s var(--ease); }
  .card:hover .oct {
    transform: rotate(22.5deg);
    filter: drop-shadow(0 0 14px color-mix(in srgb, var(--c) 70%, transparent));
  }
  .card:hover .glyph { transform: scale(1.08); }

  .card-title { font-size: 1.4rem; font-weight: 700; }
  .card-sub {
    margin: 0.4rem 0 1rem;
    font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--muted-2);
  }
  .card-text { color: var(--muted); margin: 0; font-size: 0.98rem; }

  .services-note {
    margin: clamp(2.4rem, 5vw, 3.4rem) 0 0;
    color: var(--muted-2);
    max-width: 60ch;
    font-size: 1.02rem;
  }

  .network {
    display: flex;
    align-items: center;
    gap: 1.3rem;
    margin-top: 1.6rem;
    padding: 1.5rem 1.8rem;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 6px;
    text-decoration: none;
    transition: transform 0.5s var(--ease), border-color 0.5s var(--ease), background 0.5s var(--ease);
  }
  .network:hover {
    transform: translateY(-4px);
    border-color: rgba(255,255,255,0.2);
    background: var(--bg-3);
  }
  .network-icon {
    flex: none;
    width: 48px; height: 48px;
    display: grid; place-items: center;
    background: var(--bg-3);
    border: 1px solid var(--line);
    border-radius: 50%;
  }
  .network-icon :global(img) { width: 24px; height: 24px; object-fit: contain; opacity: 0.92; }
  .network-title { font-size: 1rem; font-weight: 700; margin: 0 0 0.3rem; }
  .network-text { color: var(--muted); margin: 0; font-size: 0.92rem; max-width: 60ch; }

  @media (max-width: 820px) {
    .cards { grid-template-columns: 1fr; }
  }

  @media (max-width: 580px) {
    .network { flex-direction: column; align-items: flex-start; gap: 1rem; }
  }

  @media (max-width: 760px) {
    .card { padding: clamp(1.6rem, 6vw, 2.2rem) 1.4rem; }
    /* scroll-wake spotlight replaces :hover — the octagon ignites and the
       card lifts as it crosses screen-center, one at a time down the stack */
    .card.live { transform: translateY(-6px); border-color: color-mix(in srgb, var(--c) 55%, var(--line)); background: var(--bg-3); }
    .card.live .oct { transform: rotate(22.5deg); filter: drop-shadow(0 0 14px color-mix(in srgb, var(--c) 70%, transparent)); }
    .card.live .glyph { transform: scale(1.08); }
  }
</style>
