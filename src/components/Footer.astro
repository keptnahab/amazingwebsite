---
import Logo from "./Logo.astro";
const year = 2026;
const cols = [
  { title: "Explore", links: [
    { label: "Work", href: "/work" },
    { label: "About", href: "/#about" },
    { label: "Services", href: "/#services" },
    { label: "Contact", href: "/#contact" },
  ]},
  { title: "Legal", links: [
    { label: "Imprint", href: "/imprint" },
    { label: "Privacy", href: "/privacy" },
  ]},
];
---

<footer class="footer">
  <div class="wrap foot-top">
    <div class="foot-brand">
      <Logo size={30} />
      <p>Lighting up stages worldwide. Always with intent.</p>
    </div>
    <div class="foot-cols">
      {cols.map((c) => (
        <nav class="foot-col" aria-label={c.title}>
          <p class="foot-col-title">{c.title}</p>
          {c.links.map((l) => <a href={l.href} class="link-quiet">{l.label}</a>)}
        </nav>
      ))}
    </div>
  </div>
  <div class="wrap foot-bottom">
    <p>© {year} Michael Kühbandner · amazinglighting.design</p>
    <p>All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    background: var(--bg-1);
    padding-block: clamp(3rem, 7vw, 5rem) 2rem;
  }
  .foot-top {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(2rem, 6vw, 4rem);
  }
  .foot-brand p {
    color: var(--muted-2);
    max-width: 34ch;
    margin: 1.2rem 0 0;
    font-size: 0.95rem;
  }
  .foot-cols { display: flex; gap: clamp(2rem, 6vw, 4rem); justify-content: flex-end; }
  .foot-col { display: flex; flex-direction: column; gap: 0.7rem; }
  .foot-col-title {
    font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--muted-2); margin: 0 0 0.4rem;
  }
  .foot-col a { font-size: 0.95rem; }

  .foot-bottom {
    display: flex; justify-content: space-between;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-top: 1.6rem;
    border-top: 1px solid var(--line-soft);
    color: var(--muted-2); font-size: 0.82rem;
  }

  @media (max-width: 760px) {
    .foot-top { grid-template-columns: 1fr; }
    .foot-cols { justify-content: flex-start; }
    .foot-bottom { flex-direction: column; gap: 0.4rem; }
    .foot-col a { padding-block: 0.45rem; display: inline-block; }
    .footer { padding-bottom: max(2rem, env(safe-area-inset-bottom)); }
  }
</style>
