---
/**
 * EN ⇄ DE are two separate static builds on two domains (no client-side
 * routing) — this is a plain cross-domain link to the same path on the
 * other domain's live site.
 */
import { locale, otherLocale, domains } from "../i18n/config";

const path = Astro.url.pathname;
const targetHost = otherLocale === "de" ? `www.${domains.de}` : domains.en;
const href = `https://${targetHost}${path}`;
const label = otherLocale.toUpperCase();
---

<a href={href} class="lang-switch" aria-label={`Switch to ${otherLocale === "de" ? "Deutsch" : "English"}`}>
  {label}
</a>

<style>
  .lang-switch {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--muted-2);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.4rem 0.85rem;
    transition: color 0.25s var(--ease), border-color 0.25s var(--ease);
  }
  .lang-switch:hover {
    color: var(--text);
    border-color: rgba(255, 255, 255, 0.3);
  }
</style>
