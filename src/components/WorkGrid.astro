---
import { Image } from "astro:assets";
import { projects, type Project } from "../data/projects";

interface Props {
  showControls?: boolean;
  eyebrow?: string;
  title?: string;
  limit?: number;
}
const { showControls = false, eyebrow, title, limit } = Astro.props;

const sorted = [...projects].sort((a, b) => b.order - a.order);
const list = limit ? sorted.slice(0, limit) : sorted;

const categories = ["ALL", "BROADCAST", "CONCERTS", "CORPORATE", "THEATER", "EVENTS", "CEREMONY"];

// serialisable payload for the modal
const payload = list.map((p: Project) => ({
  slug: p.slug,
  title: p.title,
  year: p.year,
  location: p.location,
  category: p.category,
  description: p.description,
  credits: p.credits,
  images: p.gallery.map((g) => g.src),
}));
---

<section class="section work">
  <div class="wrap">
    {(eyebrow || title) && (
      <div class="work-head">
        {eyebrow && <p class="eyebrow reveal">{eyebrow}</p>}
        {title && <h2 class="section-title reveal">{title}</h2>}
        <hr class="rule reveal" />
      </div>
    )}

    {showControls && (
      <div class="controls reveal">
        <div class="search">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.5" y2="16.5" />
          </svg>
          <input type="search" id="workSearch" placeholder="Search projects, clients, venues…" aria-label="Search projects" />
        </div>
        <div class="filters" id="workFilters" role="tablist">
          {categories.map((c, i) => (
            <button class:list={["pill", "press", { on: i === 0 }]} data-filter={c} role="tab" aria-selected={i === 0}>
              {c === "ALL" ? "All Projects" : c.charAt(0) + c.slice(1).toLowerCase()}
            </button>
          ))}
        </div>
      </div>
    )}

    <div class="grid" id="workGrid">
      {list.map((p) => (
        <article class="wcard reveal" data-cat={p.category} data-spotlight data-q={`${p.title} ${p.location} ${p.year} ${p.category}`.toLowerCase()}>
          <button class="wcard-btn press" data-open={p.slug} aria-label={`Open ${p.title}`}>
            <span class="wcard-media">
              <Image src={p.cover} alt={p.title} widths={[420, 720]} sizes="(max-width: 820px) 90vw, 30vw" />
              <span class="wcard-cat">{p.category}</span>
              <span class="wcard-glow"></span>
            </span>
            <span class="wcard-body">
              <span class="wcard-title">{p.title}</span>
              <span class="wcard-meta">{p.year} · {p.location}</span>
              <span class="wcard-desc">{p.description}</span>
            </span>
          </button>
        </article>
      ))}
    </div>

    <p class="no-results" id="noResults" hidden>No projects match your search.</p>
  </div>

  <!-- Modal -->
  <div class="modal" id="workModal" hidden>
    <div class="modal-backdrop" data-close></div>
    <div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="mTitle">
      <button class="modal-close" data-close aria-label="Close">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="5" x2="19" y2="19"/><line x1="19" y1="5" x2="5" y2="19"/></svg>
      </button>
      <div class="modal-gallery">
        <div class="mg-track" id="mgTrack"></div>
        <button class="mg-arrow prev" id="mgPrev" aria-label="Previous image">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 5 8 12 15 19"/></svg>
        </button>
        <button class="mg-arrow next" id="mgNext" aria-label="Next image">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 5 16 12 9 19"/></svg>
        </button>
        <div class="mg-dots" id="mgDots"></div>
      </div>
      <div class="modal-info">
        <span class="modal-cat" id="mCat"></span>
        <h3 id="mTitle"></h3>
        <p class="modal-meta" id="mMeta"></p>
        <p class="modal-desc" id="mDesc"></p>
        <dl class="modal-credits" id="mCredits"></dl>
      </div>
    </div>
  </div>

  <script type="application/json" id="projData" set:html={JSON.stringify(payload)}></script>
</section>

<script>
  type P = { slug:string; title:string; year:string; location:string; category:string; description:string; credits:{role:string;name:string}[]; images:string[] };
  const data: P[] = JSON.parse(document.getElementById("projData")?.textContent || "[]");
  const bySlug = new Map(data.map((p) => [p.slug, p]));

  /* ---- filter + search ---- */
  const grid = document.getElementById("workGrid");
  const cards = [...document.querySelectorAll<HTMLElement>(".wcard")];
  const filters = document.getElementById("workFilters");
  const search = document.getElementById("workSearch") as HTMLInputElement | null;
  const noResults = document.getElementById("noResults");
  let activeCat = "ALL";

  function applyFilter() {
    const q = (search?.value || "").trim().toLowerCase();
    let shown = 0;
    cards.forEach((c) => {
      const okCat = activeCat === "ALL" || c.dataset.cat === activeCat;
      const okQ = !q || (c.dataset.q || "").includes(q);
      const show = okCat && okQ;
      c.style.display = show ? "" : "none";
      if (show) shown++;
    });
    if (noResults) noResults.hidden = shown !== 0;
  }
  filters?.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>(".pill");
    if (!btn) return;
    filters.querySelectorAll(".pill").forEach((p) => { p.classList.remove("on"); p.setAttribute("aria-selected","false"); });
    btn.classList.add("on"); btn.setAttribute("aria-selected","true");
    activeCat = btn.dataset.filter || "ALL";
    applyFilter();
  });
  search?.addEventListener("input", applyFilter);

  /* ---- modal + gallery ---- */
  const modal = document.getElementById("workModal")!;
  const track = document.getElementById("mgTrack")!;
  const dotsWrap = document.getElementById("mgDots")!;
  const mCat = document.getElementById("mCat")!;
  const mTitle = document.getElementById("mTitle")!;
  const mMeta = document.getElementById("mMeta")!;
  const mDesc = document.getElementById("mDesc")!;
  const mCredits = document.getElementById("mCredits")!;
  let gi = 0, gcount = 0, timer: number | undefined, lastFocus: HTMLElement | null = null;
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function goTo(n: number) {
    gi = (n + gcount) % gcount;
    track.style.transform = `translateX(-${gi * 100}%)`;
    dotsWrap.querySelectorAll(".mg-dot").forEach((d, i) => d.classList.toggle("on", i === gi));
  }
  function autoplay() {
    clearInterval(timer);
    if (!reduce && gcount > 1) timer = window.setInterval(() => goTo(gi + 1), 4500);
  }
  function open(slug: string) {
    const p = bySlug.get(slug); if (!p) return;
    lastFocus = document.activeElement as HTMLElement;
    mCat.textContent = p.category;
    mTitle.textContent = p.title;
    mMeta.textContent = `${p.year} · ${p.location}`;
    mDesc.textContent = p.description;
    mCredits.innerHTML = p.credits.map((c) => `<div class="cr"><dt>${c.role}</dt><dd>${c.name}</dd></div>`).join("");
    track.innerHTML = p.images.map((src) => `<div class="mg-slide"><img src="${src}" alt="${p.title}" loading="lazy" /></div>`).join("");
    gcount = p.images.length; gi = 0;
    track.style.transform = "translateX(0)";
    dotsWrap.innerHTML = p.images.map((_, i) => `<button class="mg-dot${i===0?" on":""}" data-go="${i}" aria-label="Image ${i+1}"></button>`).join("");
    modal.hidden = false;
    document.body.style.overflow = "hidden";
    requestAnimationFrame(() => modal.classList.add("show"));
    (modal.querySelector(".modal-close") as HTMLElement)?.focus();
    autoplay();
  }
  function close() {
    modal.classList.remove("show");
    clearInterval(timer);
    const panelEl = modal.querySelector(".modal-panel") as HTMLElement | null;
    if (panelEl) panelEl.style.transform = "";
    setTimeout(() => { modal.hidden = true; document.body.style.overflow = ""; lastFocus?.focus(); }, 280);
  }

  grid?.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-open]");
    if (btn) open(btn.dataset.open!);
  });
  modal.addEventListener("click", (e) => {
    const t = e.target as HTMLElement;
    if (t.closest("[data-close]")) close();
    const dot = t.closest<HTMLElement>(".mg-dot");
    if (dot) { goTo(+dot.dataset.go!); autoplay(); }
  });
  document.getElementById("mgPrev")?.addEventListener("click", () => { goTo(gi - 1); autoplay(); });
  document.getElementById("mgNext")?.addEventListener("click", () => { goTo(gi + 1); autoplay(); });
  document.addEventListener("keydown", (e) => {
    if (modal.hidden) return;
    if (e.key === "Escape") close();
    if (e.key === "ArrowLeft") { goTo(gi - 1); autoplay(); }
    if (e.key === "ArrowRight") { goTo(gi + 1); autoplay(); }
  });

  /* ---- mobile gestures: swipe the gallery, swipe-down to dismiss ---- */
  const panel = modal.querySelector(".modal-panel") as HTMLElement;
  let tStartX = 0, tStartY = 0, tDX = 0, tDY = 0, tracking = false;

  track.addEventListener("touchstart", (e) => {
    const t = e.touches[0];
    tStartX = t.clientX; tStartY = t.clientY; tDX = 0; tDY = 0; tracking = true;
    clearInterval(timer);
  }, { passive: true });
  track.addEventListener("touchmove", (e) => {
    if (!tracking) return;
    const t = e.touches[0];
    tDX = t.clientX - tStartX; tDY = t.clientY - tStartY;
  }, { passive: true });
  track.addEventListener("touchend", () => {
    if (!tracking) return;
    tracking = false;
    const threshold = track.clientWidth * 0.18;
    if (Math.abs(tDX) > threshold && Math.abs(tDX) > Math.abs(tDY)) goTo(tDX < 0 ? gi + 1 : gi - 1);
    autoplay();
  }, { passive: true });

  let pStartY = 0, pDY = 0, pDragging = false;
  panel?.addEventListener("touchstart", (e) => {
    if ((e.target as HTMLElement).closest("#mgTrack")) return; // gallery handles its own swipe
    pStartY = e.touches[0].clientY; pDY = 0; pDragging = true;
  }, { passive: true });
  panel?.addEventListener("touchmove", (e) => {
    if (!pDragging) return;
    pDY = e.touches[0].clientY - pStartY;
    if (pDY > 0) panel.style.transform = `translateY(${pDY}px)`;
  }, { passive: true });
  panel?.addEventListener("touchend", () => {
    if (!pDragging) return;
    pDragging = false;
    if (pDY > 100) close();
    panel.style.transform = "";
  }, { passive: true });
</script>

<style>
  .work-head { margin-bottom: clamp(1.6rem, 4vw, 2.6rem); }

  /* controls */
  .controls {
    display: flex; flex-direction: column; gap: 1.1rem;
    margin-bottom: 2.2rem;
  }
  .search {
    display: flex; align-items: center; gap: 0.7rem;
    background: var(--bg-2); border: 1px solid var(--line);
    border-radius: 999px; padding: 0.7rem 1.1rem; color: var(--muted-2);
    max-width: 420px; transition: border-color 0.3s var(--ease);
  }
  .search:focus-within { border-color: rgba(255,255,255,0.25); }
  .search input {
    flex: 1; background: none; border: 0; color: var(--text);
    font: inherit; font-size: 0.95rem; outline: none;
  }
  .search input::placeholder { color: var(--muted-2); }

  .filters { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .pill {
    background: var(--bg-2); border: 1px solid var(--line);
    color: var(--muted); font: inherit; font-size: 0.85rem; font-weight: 500;
    padding: 0.5rem 1.05rem; border-radius: 999px; cursor: pointer;
    transition: all 0.25s var(--ease);
  }
  .pill:hover { color: var(--text); border-color: rgba(255,255,255,0.2); }
  .pill.on { background: var(--text); color: #0a0a0c; border-color: var(--text); }

  /* grid */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
  }
  .wcard { min-width: 0; }
  .wcard-btn {
    display: flex; flex-direction: column; width: 100%; text-align: left;
    background: var(--bg-2); border: 1px solid var(--line); border-radius: 7px;
    padding: 0; cursor: pointer; overflow: hidden; color: inherit; font: inherit;
    transition: transform 0.5s var(--ease), border-color 0.5s var(--ease);
  }
  .wcard-btn:hover { transform: translateY(-5px); border-color: rgba(255,255,255,0.2); }
  .wcard-media {
    position: relative; display: block; aspect-ratio: 3 / 2; overflow: hidden;
  }
  .wcard-media :global(img) {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.8s var(--ease), filter 0.6s var(--ease);
  }
  .wcard-btn:hover .wcard-media :global(img) { transform: scale(1.07); filter: brightness(1.08); }
  .wcard-glow {
    position: absolute; inset: 0; pointer-events: none; opacity: 0;
    background: radial-gradient(120% 70% at 50% 0%, rgba(255,255,255,0.22), transparent 60%);
    transition: opacity 0.6s var(--ease);
  }
  .wcard-btn:hover .wcard-glow { opacity: 1; }
  .wcard-cat {
    position: absolute; top: 0.8rem; left: 0.8rem;
    font-size: 0.62rem; letter-spacing: 0.18em; font-weight: 600;
    padding: 0.3rem 0.6rem; border-radius: 4px;
    background: rgba(10,10,12,0.6); backdrop-filter: blur(6px);
    color: var(--text); text-transform: uppercase;
  }
  .wcard-body { padding: 1.3rem 1.3rem 1.5rem; display: flex; flex-direction: column; gap: 0.35rem; }
  .wcard-title { font-size: 1.18rem; font-weight: 700; letter-spacing: -0.02em; }
  .wcard-meta { font-size: 0.8rem; color: var(--muted-2); letter-spacing: 0.04em; }
  .wcard-desc { font-size: 0.92rem; color: var(--muted); margin-top: 0.4rem; line-height: 1.5; }

  .no-results { color: var(--muted-2); margin-top: 2rem; }

  /* modal */
  .modal { position: fixed; inset: 0; z-index: 200; display: grid; place-items: center; }
  .modal[hidden] { display: none; }
  .modal-backdrop {
    position: absolute; inset: 0; background: rgba(5,5,7,0.8);
    backdrop-filter: blur(6px); opacity: 0; transition: opacity 0.28s var(--ease);
  }
  .modal.show .modal-backdrop { opacity: 1; }
  .modal-panel {
    position: relative; z-index: 1;
    width: min(980px, 92vw); max-height: 90vh; overflow: auto;
    background: var(--bg-1); border: 1px solid var(--line); border-radius: 10px;
    transform: translateY(14px) scale(0.985); opacity: 0;
    transition: transform 0.32s var(--ease), opacity 0.32s var(--ease);
  }
  .modal.show .modal-panel { transform: none; opacity: 1; }
  .modal-close {
    position: absolute; top: 0.8rem; right: 0.8rem; z-index: 3;
    width: 40px; height: 40px; border-radius: 50%; cursor: pointer;
    background: rgba(10,10,12,0.55); border: 1px solid var(--line); color: var(--text);
    display: grid; place-items: center; backdrop-filter: blur(6px);
    transition: background 0.25s var(--ease);
  }
  .modal-close:hover { background: rgba(10,10,12,0.85); }

  .modal-gallery { position: relative; aspect-ratio: 16 / 9; background: #000; overflow: hidden; }
  .mg-track { display: flex; height: 100%; transition: transform 0.55s var(--ease); }
  /* slides are injected via JS → must be global (scoped styles won't match) */
  :global(.mg-slide) { min-width: 100%; height: 100%; }
  :global(.mg-slide img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .mg-arrow {
    position: absolute; top: 50%; transform: translateY(-50%);
    width: 44px; height: 44px; border-radius: 50%; cursor: pointer;
    background: rgba(10,10,12,0.5); border: 1px solid var(--line); color: var(--text);
    display: grid; place-items: center; backdrop-filter: blur(6px);
    transition: background 0.25s var(--ease), opacity 0.25s var(--ease);
  }
  .mg-arrow:hover { background: rgba(10,10,12,0.85); }
  .mg-arrow.prev { left: 0.8rem; } .mg-arrow.next { right: 0.8rem; }
  .mg-dots { position: absolute; bottom: 0.9rem; left: 50%; transform: translateX(-50%); display: flex; gap: 0.4rem; }
  :global(.mg-dot) { width: 8px; height: 8px; border-radius: 50%; border: 0; cursor: pointer; background: rgba(255,255,255,0.35); transition: all 0.25s var(--ease); padding: 0; }
  :global(.mg-dot.on) { background: #fff; width: 22px; border-radius: 4px; }

  .modal-info { padding: clamp(1.6rem, 3vw, 2.4rem); }
  .modal-cat { font-size: 0.66rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted-2); }
  .modal-info h3 { font-size: clamp(1.6rem, 3vw, 2.2rem); margin: 0.5rem 0 0.4rem; }
  .modal-meta { color: var(--muted); margin: 0 0 1.2rem; font-size: 0.92rem; letter-spacing: 0.03em; }
  .modal-desc { color: var(--text); max-width: 62ch; margin: 0 0 1.8rem; font-size: 1.05rem; line-height: 1.6; }
  .modal-credits { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.6rem 2rem; margin: 0; padding-top: 1.4rem; border-top: 1px solid var(--line); }
  :global(.modal-credits .cr) { display: flex; flex-direction: column; gap: 0.1rem; }
  :global(.modal-credits dt) { font-size: 0.66rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted-2); }
  :global(.modal-credits dd) { margin: 0; font-size: 0.95rem; color: var(--text); }

  @media (max-width: 900px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 760px) {
    /* one big cinematic cover per row — photos as the hero, per owner direction */
    .grid { grid-template-columns: 1fr; }
    .modal-credits { grid-template-columns: 1fr; }

    /* scroll-wake spotlight replaces :hover */
    .wcard.live .wcard-btn { transform: translateY(-4px); border-color: rgba(255,255,255,0.2); }
    .wcard.live .wcard-media :global(img) { transform: scale(1.05); filter: brightness(1.06); }
    .wcard.live .wcard-glow { opacity: 0.6; }

    /* filters: horizontal scroll-snap chip rail instead of wrapping */
    .filters {
      flex-wrap: nowrap; overflow-x: auto; scroll-snap-type: x proximity;
      -webkit-overflow-scrolling: touch; scrollbar-width: none;
      margin-inline: calc(var(--pad) * -1); padding-inline: var(--pad);
      padding-bottom: 0.2rem;
      mask-image: linear-gradient(90deg, #000 calc(100% - 28px), transparent 100%);
    }
    .filters::-webkit-scrollbar { display: none; }
    .pill { flex: 0 0 auto; scroll-snap-align: start; }
    .search input { font-size: 16px; } /* stops iOS zoom-on-focus */

    /* modal: near-full-screen native sheet */
    .modal-panel {
      width: 100vw; height: 100svh; max-height: none; border-radius: 0;
      overscroll-behavior: contain;
      transform: translateY(100%); opacity: 1;
      transition: transform 0.34s var(--ease);
    }
    .modal.show .modal-panel { transform: translateY(0); }
    .modal-close { top: max(0.8rem, env(safe-area-inset-top)); right: max(0.8rem, env(safe-area-inset-right)); width: 44px; height: 44px; }

    /* gallery matches the source stage-photo ratio — no re-crop — and is swipeable */
    .modal-gallery { aspect-ratio: 3 / 2; }
    .mg-arrow { display: none; }
  }
</style>
