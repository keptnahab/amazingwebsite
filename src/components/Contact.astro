---
import { t, locale } from "../i18n/config";
const emailUser = "info";
const emailDomain = locale === "de" ? "tolleslicht.de" : "amazinglighting.design";
---

<section class="section contact" id="contact">
  <div class="wrap">
    <p class="eyebrow reveal">{t.contact.eyebrow}</p>
    <h2 class="section-title reveal">{t.contact.title}</h2>
    <hr class="rule reveal" />

    <div class="contact-grid">
      <p class="contact-lead reveal">
        {t.contact.lead}
      </p>

      <div class="contact-details reveal">
        <a class="detail js-email" data-u={emailUser} data-d={emailDomain} href="#">
          <span class="detail-label">{t.contact.email}</span>
          <span class="detail-value" set:html={`${emailUser}&#64;${emailDomain}`}></span>
        </a>
        <div class="detail">
          <span class="detail-label">{t.contact.basedIn}</span>
          <span class="detail-value">{t.contact.location}</span>
        </div>
        <a class="detail" href="https://www.facebook.com/michael.kuehbandner" target="_blank" rel="noopener">
          <span class="detail-label">{t.contact.facebook}</span>
          <span class="detail-value">Michael Kühbandner →</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('a.js-email').forEach(a => {
    const el = a as HTMLAnchorElement & { dataset: { u?: string; d?: string } };
    el.href = 'mailto:' + el.dataset.u + '@' + el.dataset.d;
  });
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
    margin-top: clamp(1.6rem, 4vw, 2.6rem);
  }
  .contact-lead {
    color: var(--muted);
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    line-height: 1.5;
    max-width: 32ch;
    margin: 0;
  }
  .contact-details { display: flex; flex-direction: column; }
  .detail {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.3rem 0;
    border-top: 1px solid var(--line);
  }
  .detail:last-child { border-bottom: 1px solid var(--line); }
  .detail-label {
    font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--muted-2);
  }
  .detail-value { font-size: 1.15rem; font-weight: 600; transition: color 0.3s var(--ease); }
  a.detail:hover .detail-value { color: var(--text); }
  a.detail .detail-value { color: var(--muted); }

  @media (max-width: 820px) {
    .contact-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 760px) {
    .detail { padding: 1.4rem 0; min-height: 56px; justify-content: center; }
    a.detail:active .detail-value { color: var(--text); }
  }
</style>
