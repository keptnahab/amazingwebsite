---
const email = "info@amazinglighting.design";
---

<section class="section contact" id="contact">
  <div class="wrap">
    <p class="eyebrow reveal">Contact</p>
    <h2 class="section-title reveal">Let's light it up.</h2>
    <hr class="rule reveal" />

    <div class="contact-grid">
      <p class="contact-lead reveal">
        Planning a stadium event, concert tour, corporate show or broadcast production?
        I work internationally and am available for projects of all scales.
      </p>

      <div class="contact-details reveal">
        <a class="detail" href={`mailto:${email}`}>
          <span class="detail-label">Email</span>
          <span class="detail-value">{email}</span>
        </a>
        <div class="detail">
          <span class="detail-label">Based in</span>
          <span class="detail-value">Munich, Germany · available worldwide</span>
        </div>
        <a class="detail" href="https://instagram.com/" target="_blank" rel="noopener">
          <span class="detail-label">Instagram</span>
          <span class="detail-value">@amazinglighting →</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
    margin-top: clamp(1.6rem, 4vw, 2.6rem);
  }
  .contact-lead {
    color: var(--muted);
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    line-height: 1.5;
    max-width: 32ch;
    margin: 0;
  }
  .contact-details { display: flex; flex-direction: column; }
  .detail {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.3rem 0;
    border-top: 1px solid var(--line);
  }
  .detail:last-child { border-bottom: 1px solid var(--line); }
  .detail-label {
    font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--muted-2);
  }
  .detail-value { font-size: 1.15rem; font-weight: 600; transition: color 0.3s var(--ease); }
  a.detail:hover .detail-value { color: var(--text); }
  a.detail .detail-value { color: var(--muted); }

  @media (max-width: 820px) {
    .contact-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 760px) {
    .detail { padding: 1.4rem 0; min-height: 56px; justify-content: center; }
    a.detail:active .detail-value { color: var(--text); }
  }
</style>
