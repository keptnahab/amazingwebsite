---
import hero01 from "../assets/hero/01-samsung-booth-ces.jpg";
import hero02 from "../assets/hero/02-sony-booth-ifa.jpg";
import hero03 from "../assets/hero/03-audi-a5-reveal-china.jpg";
import hero04 from "../assets/hero/04-brandner-kasper.jpg";
import hero05 from "../assets/hero/05-romeo-and-juliet.jpg";
import hero06 from "../assets/hero/06-romeo-and-juliet-ii.jpg";
import hero07 from "../assets/hero/07-geist-der-weihnacht.jpg";
import hero08 from "../assets/hero/08-starmania.jpg";
import hero09 from "../assets/hero/09-musikhelden.jpg";
import hero10 from "../assets/hero/10-bavaria-sounds.jpg";
import hero11 from "../assets/hero/11-apache-tour.jpg";
import hero12 from "../assets/hero/12-klangwolke-linz.jpg";
import hero13 from "../assets/hero/13-audi-etron-clt.jpg";
import hero14 from "../assets/hero/14-circle-of-light.jpg";
import hero15 from "../assets/hero/15-arab-gulf-cup-kuwait.jpg";
import hero16 from "../assets/hero/16-asia-cup-doha.jpg";

// project · client come straight from the IntroSlider filenames
const slides = [
  { src: hero01.src, project: "Samsung Booth at CES",  client: "Freestate" },
  { src: hero02.src, project: "Sony Booth at IFA",      client: "Freestate" },
  { src: hero03.src, project: "Audi A5 Reveal China",   client: "Amir Vaziri" },
  { src: hero04.src, project: "Brandner Kasper",        client: "Charly Pauli" },
  { src: hero05.src, project: "Romeo and Juliet",       client: "Roland Greil" },
  { src: hero06.src, project: "Romeo and Juliet",       client: "Roland Greil" },
  { src: hero07.src, project: "Geist der Weihnacht",    client: "Festspielhaus Füssen" },
  { src: hero08.src, project: "Starmania",              client: "Roland Greil" },
  { src: hero09.src, project: "Musikhelden",            client: "Systemprovider" },
  { src: hero10.src, project: "Bavaria Sounds",         client: "Roland Greil" },
  { src: hero11.src, project: "Apache Tour",            client: "Roland Greil" },
  { src: hero12.src, project: "Klangwolke Linz",        client: "Roland Greil" },
  { src: hero13.src, project: "Audi e-tron CLT",        client: "Audi" },
  { src: hero14.src, project: "Circle of Light",        client: "Jerry Appelt" },
  { src: hero15.src, project: "Arab Gulf Cup Kuwait",   client: "Roland Greil" },
  { src: hero16.src, project: "Asia Cup Doha",          client: "Roland Greil" },
];

// testimonials (short pull-quotes) — name · role · organisation
const quotes = [
  { text: "You were a joy to work with, and a machine. Not many people could have stayed this focused for that long.", name: "Terry Cook", role: "Principal Designer", org: "Woodroffe Basset Design" },
  { text: "A remarkable level of professionalism and dedication — and for persevering whenever challenges arose.", name: "Mahmoud Hamaky", role: "Executive Producer", org: "Katara Studios" },
  { text: "Thank you so much for the beautiful lighting, as well as for your exceptional durability!", name: "Malte Joergens", role: "Creative Director", org: "adhoc engineering" },
  { text: "Truly amazing lights, you did an awesome job!", name: "Kurt Pongratz", role: "TV Director", org: "ORF" },
  { text: "Thank you for your ambition, your professionalism, and the calm sovereignty you exude throughout the production.", name: "Thomas Stammberger", role: "Director", org: "BR" },
  { text: "An essential partner at every stage of the process — from the first designs through detailing and development, to on-site direction and delivery.", name: "Adam Scott", role: "Founder", org: "Freestate London" },
  { text: "Wow, we would never have expected that. Simply amazing — your expertise and commitment made it all possible.", name: "M. Flossmann", role: "Marketing Communication", org: "OCÉ Printing Systems" },
  { text: "Really crazy on the MA desk, and you have a hugely cool way of working!", name: "Florian Ploder", role: "CEO", org: "PS Eventconsulting" },
  { text: "The lighting design delivered was amazing — a delight to work with, super professional, friendly, and very reliable.", name: "Anna Rank", role: "Project Manager", org: "Hassell London" },
  { text: "A great eye for the whole, time and again earning the role of lighting director and programmer — always to everybody's content.", name: "Jogi Foerg", role: "Senior Key Account Manager", org: "PRG Germany" },
  { text: "Professional, touching, beautiful — despite the short time, an excellent job reaching people on-site and at home.", name: "Felix Finkbeiner", role: "CEO", org: "Plant-for-the-Planet" },
  { text: "It has always been a pleasure to work with such a refreshing approach to the entertainment design process.", name: "Patrick Dierson", role: "President", org: "Dierson Design Group" },
  { text: "Deeply grateful for the knowledge shared in an entertaining and professionally unique manner — work we can only recommend.", name: "Hudson Barnes", role: "President", org: "JSAV Mexico & the Caribbean" },
];
---

<section class="hero" id="top">
  <div class="stage" aria-hidden="true">
    {slides.map((s, i) => (
      <img src={s.src} alt="" class:list={["slide", { active: i === 0 }]} data-i={i} loading="eager" decoding="async" fetchpriority={i === 0 ? "high" : "low"} />
    ))}
    <div class="scrim"></div>
  </div>

  <div class="wrap hero-bottom">
    <figure class="quote" id="quote">
      <blockquote id="qText">{quotes[0].text}</blockquote>
      <figcaption id="qAttr">
        <span class="q-name">{quotes[0].name}</span>
        <span class="q-meta">{quotes[0].role} · {quotes[0].org}</span>
      </figcaption>
    </figure>
    <p class="credit" id="credit">
      <span class="credit-project">{slides[0].project}</span>
      <span class="credit-client">Client: {slides[0].client}</span>
    </p>
  </div>

  <a href="/#about" class="scroll-cue" aria-label="Scroll down">
    <span></span>
  </a>
</section>

<script
  define:vars={{ slides, quotes }}
>
  const imgs = [...document.querySelectorAll(".slide")];
  const credit = document.getElementById("credit");
  const qText = document.getElementById("qText");
  const qAttr = document.getElementById("qAttr");
  const quoteEl = document.getElementById("quote");
  let si = 0;
  let qi = 0;
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // match the quote column's width to the header logo lockup, so the
  // text block's left/right edges line up with where the logo starts and ends
  function syncQuoteWidth() {
    const brand = document.querySelector(".site-header .brand");
    if (brand && quoteEl) quoteEl.style.width = `${brand.getBoundingClientRect().width}px`;
  }
  syncQuoteWidth();
  window.addEventListener("resize", syncQuoteWidth);
  window.addEventListener("load", syncQuoteWidth);

  function showSlide(n) {
    const prev = si;
    si = (n + slides.length) % slides.length;
    if (prev !== si) {
      // removing .active cancels the kenburns animation, which snaps the
      // transform back to the base value with no transition (animations
      // don't hand off to transitions on removal). Freeze the current
      // mid-zoom value as an inline style first, then release it a frame
      // later so the existing transform transition eases it back down.
      const prevEl = imgs[prev];
      const frozen = getComputedStyle(prevEl).transform;
      prevEl.classList.remove("active");
      prevEl.style.transform = frozen;
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          prevEl.style.transform = "";
        });
      });
    }
    imgs[si].classList.add("active");
    const s = slides[si];
    credit.innerHTML = `<span class="credit-project">${s.project}</span><span class="credit-client">Client: ${s.client}</span>`;
  }
  function showQuote(n) {
    qi = (n + quotes.length) % quotes.length;
    quoteEl.classList.add("fade");
    setTimeout(() => {
      const q = quotes[qi];
      qText.textContent = q.text;
      qAttr.innerHTML = `<span class="q-name">${q.name}</span><span class="q-meta">${q.role} · ${q.org}</span>`;
      quoteEl.classList.remove("fade");
    }, 1200);
  }

  if (!reduce) {
    // wait for every slide to be decoded so the very first cycle never shows a half-loaded frame
    Promise.allSettled(imgs.map((im) => im.decode ? im.decode() : Promise.resolve())).then(() => {
      setInterval(() => showSlide(si + 1), 8500);
    });
    setInterval(() => showQuote(qi + 1), 10000);
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
  }
  .stage { position: absolute; inset: 0; z-index: 0; background: #000; }
  .slide {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.06);
    transition: opacity 4.5s ease-in-out, transform 4.5s ease-in-out;
  }
  .slide.active {
    opacity: 1;
    animation: kenburns 26s linear forwards;
  }
  @keyframes kenburns {
    from { transform: scale(1.06); }
    to   { transform: scale(1.14); }
  }
  .scrim {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(10,10,12,0.6) 0%, rgba(10,10,12,0) 26%),
      linear-gradient(0deg, rgba(10,10,12,0.96) 0%, rgba(10,10,12,0.78) 26%, rgba(10,10,12,0.32) 52%, rgba(10,10,12,0) 78%);
  }

  .hero-bottom {
    position: relative; z-index: 2;
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: 2rem;
    padding-bottom: 1.8rem;
  }
  .quote { margin: 0; width: 16em; max-width: 60vw; flex: none; }
  .quote blockquote {
    margin: 0;
    font-size: clamp(1.4rem, 2.6vw, 2.15rem);
    font-weight: 600;
    line-height: 1.18;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .quote blockquote::before { content: "“"; color: var(--muted-2); margin-right: 0.05em; }
  .quote blockquote::after { content: "”"; color: var(--muted-2); }
  .quote figcaption {
    display: flex; flex-direction: column; gap: 0.1rem;
    margin-top: 1.2rem;
  }
  .q-name { font-weight: 600; font-size: 0.98rem; }
  .q-meta { color: var(--muted-2); font-size: 0.85rem; letter-spacing: 0.02em; }
  .quote { transition: opacity 1.3s ease-in-out; }
  .quote.fade { opacity: 0; }

  .credit {
    margin: 0; flex: none;
    display: flex; flex-direction: column; gap: 0.25rem;
    font-size: 0.8rem; color: var(--muted);
    letter-spacing: 0.03em; text-align: right;
  }
  .credit-project { color: var(--text); font-weight: 600; }
  .credit-client { color: var(--muted); }

  .scroll-cue {
    position: absolute; left: 50%; bottom: 1.5rem; z-index: 2;
    transform: translateX(-50%);
    width: 22px; height: 34px; border: 1px solid rgba(255,255,255,0.4);
    border-radius: 12px; display: none;
  }
  .scroll-cue span {
    position: absolute; left: 50%; top: 7px; width: 3px; height: 7px;
    background: #fff; border-radius: 2px; transform: translateX(-50%);
    animation: cue 1.8s var(--ease) infinite;
  }
  @keyframes cue { 0%{opacity:0;transform:translate(-50%,0)} 30%{opacity:1} 100%{opacity:0;transform:translate(-50%,10px)} }

  @media (min-width: 900px) { .scroll-cue { display: block; } }
  @media (prefers-reduced-motion: reduce) {
    .slide.active { animation: none; }
    .scroll-cue span { animation: none; }
  }
</style>
