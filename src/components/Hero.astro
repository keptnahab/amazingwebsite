---
import type { ImageMetadata } from "astro";
import { heroSlidesData } from "../data/hero.data";
import { t } from "../i18n/config";

// images are auto-discovered from src/assets/hero/ via glob — see
// scripts/import-hero.mjs for how to add a new slide. heroSlidesData is
// already ordered newest-first (highest NN first).
const heroImages = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/hero/*.{jpg,jpeg,png,webp}",
  { eager: true }
);

const slides = heroSlidesData
  .map((d) => {
    const mod = heroImages[`../assets/hero/${d.file}`];
    if (!mod) return null;
    return { src: mod.default.src, project: d.project, client: d.client };
  })
  .filter((s): s is { src: string; project: string; client: string } => s !== null);

// the hero deliberately carries images + project credit only — the client
// testimonials that used to sit here live in Testimonials.astro, the
// section below About
---

<section class="hero" id="top">
  <div class="stage" aria-hidden="true">
    {slides.map((s, i) => (
      <img
        src={s.src}
        alt=""
        class:list={["slide", { active: i === 0 }]}
        data-i={i}
        style={`--focal:${s.focal ?? 50}%`}
        loading={i < 2 ? "eager" : "lazy"}
        decoding="async"
        fetchpriority={i === 0 ? "high" : "low"}
      />
    ))}
    <div class="scrim"></div>
  </div>

  <p class="credit" id="credit">
    <span class="credit-project">{slides[0].project}</span>
    <span class="credit-client">{t.hero.client}: {slides[0].client}</span>
  </p>

  <a href="/#about" class="scroll-cue" aria-label={t.hero.scrollDown}>
    <span></span>
  </a>
</section>

<script
  define:vars={{ slides, i18nHero: t.hero }}
>
  const imgs = [...document.querySelectorAll(".slide")];
  const credit = document.getElementById("credit");
  const cue = document.querySelector(".scroll-cue");
  let si = 0;
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const isMobile = () => window.matchMedia("(max-width: 760px)").matches;

  function showSlide(n) {
    const prev = si;
    si = (n + slides.length) % slides.length;
    if (prev !== si) {
      // removing .active cancels the running animation (kenburns on desktop,
      // heropan on mobile), which snaps transform/object-position back to
      // their base values with no transition (animations don't hand off to
      // transitions on removal). Freeze the current mid-animation values as
      // inline styles first, then release them a frame later so the existing
      // transitions ease back down instead of jumping.
      const prevEl = imgs[prev];
      const cs = getComputedStyle(prevEl);
      const frozenTransform = cs.transform;
      const frozenObjectPosition = cs.objectPosition;
      prevEl.classList.remove("active");
      prevEl.style.transform = frozenTransform;
      prevEl.style.objectPosition = frozenObjectPosition;
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          prevEl.style.transform = "";
          prevEl.style.objectPosition = "";
        });
      });
    }
    imgs[si].classList.add("active");
    const s = slides[si];
    credit.innerHTML = `<span class="credit-project">${s.project}</span><span class="credit-client">${i18nHero.client}: ${s.client}</span>`;
  }
  if (cue) {
    window.addEventListener("scroll", () => {
      if (!isMobile()) return;
      cue.style.opacity = window.scrollY > 40 ? "0" : "1";
    }, { passive: true });
  }

  if (!reduce) {
    if (isMobile()) {
      // mobile: most slides load lazily anyway, don't gate the whole
      // rotation on decoding all 16 up front — start right away
      setInterval(() => showSlide(si + 1), 8500);
    } else {
      // desktop: wait for every (eager-loaded) slide to decode so the very
      // first cycle never shows a half-loaded frame
      Promise.allSettled(imgs.map((im) => im.decode ? im.decode() : Promise.resolve())).then(() => {
        setInterval(() => showSlide(si + 1), 8500);
      });
    }
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
  }
  .stage { position: absolute; inset: 0; z-index: 0; background: #000; }
  .slide {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.06);
    object-position: 50% center;
    transition: opacity 4.5s ease-in-out, transform 4.5s ease-in-out, object-position 4.5s ease-in-out;
  }
  .slide.active {
    opacity: 1;
    animation: kenburns 26s linear forwards;
  }
  @keyframes kenburns {
    from { transform: scale(1.06); }
    to   { transform: scale(1.14); }
  }
  /* the bottom half used to carry a testimonial and needed a heavy lift —
     with only the project credit left down there, the scrim can stay light
     and give the photos back */
  .scrim {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(10,10,12,0.45) 0%, rgba(10,10,12,0) 22%),
      linear-gradient(0deg, rgba(10,10,12,0.55) 0%, rgba(10,10,12,0.28) 16%, rgba(10,10,12,0.08) 32%, rgba(10,10,12,0) 48%);
  }

  .credit {
    position: absolute; z-index: 2;
    right: var(--pad); bottom: 1.8rem;
    margin: 0;
    display: flex; flex-direction: column; gap: 0.1rem;
    letter-spacing: 0.03em; text-align: right;
    /* the scrim is intentionally light so the photos stay visible — this
       text-shadow (inherited by the credit spans, which are rewritten via
       innerHTML on every slide) is the legibility safety net */
    text-shadow: 0 2px 16px rgba(0,0,0,0.75), 0 1px 3px rgba(0,0,0,0.7);
  }
  /* :global — same reason: credit-project/-client are rewritten via
     innerHTML on every slide change */
  :global(.credit-project) { color: var(--text); font-weight: 600; font-size: 0.98rem; }
  :global(.credit-client) { color: var(--muted-2); font-size: 0.85rem; letter-spacing: 0.02em; }

  .scroll-cue {
    display: none;
    position: absolute; left: 50%; bottom: 2rem; z-index: 2;
    width: 22px; height: 34px; transform: translateX(-50%);
  }
  .scroll-cue span {
    position: absolute; left: 50%; top: 7px; width: 3px; height: 7px;
    background: #fff; border-radius: 2px; transform: translateX(-50%);
    animation: cue 1.8s var(--ease) infinite;
  }
  @keyframes cue { 0%{opacity:0;transform:translate(-50%,0)} 30%{opacity:1} 100%{opacity:0;transform:translate(-50%,10px)} }

  @media (prefers-reduced-motion: reduce) {
    .slide.active { animation: none; }
    .scroll-cue span { animation: none; }
  }

  /* ---- mobile (<=760px): full-bleed focal pan instead of Ken Burns,
     credit becomes a small vertical caption on the right edge ---- */
  @media (max-width: 760px) {
    .scrim {
      background:
        linear-gradient(180deg, rgba(10,10,12,0.5) 0%, rgba(10,10,12,0) 20%),
        linear-gradient(0deg, rgba(10,10,12,0.6) 0%, rgba(10,10,12,0.3) 14%, rgba(10,10,12,0.08) 28%, rgba(10,10,12,0) 42%);
    }

    .slide.active {
      animation: heropan 8.5s ease-in-out infinite alternate;
    }
    @keyframes heropan {
      from { object-position: calc(var(--focal, 50%) - 7%) center; transform: scale(1.04); }
      to   { object-position: calc(var(--focal, 50%) + 7%) center; transform: scale(1.04); }
    }

    /* vertical caption, right edge, vertically centered — a quiet film/
       photo-credit treatment */
    .credit {
      top: 50%; right: 0.5rem; bottom: auto;
      transform: translateY(-50%);
      writing-mode: vertical-rl;
      text-orientation: sideways;
      flex-direction: row;
      gap: 0.6rem;
      opacity: 0.92;
    }
    /* :global — the credit spans are rewritten via innerHTML on every slide
       change, so they never carry Astro's scoped data-cid attribute and a
       plain scoped ::before would silently stop matching after rotation 1 */
    :global(.credit-client)::before { content: "· "; }
    :global(.credit-project) { font-size: 0.8rem; }
    :global(.credit-client) { font-size: 0.76rem; color: var(--muted); }

  }
  @media (max-width: 760px) and (prefers-reduced-motion: reduce) {
    .slide.active { animation: none; }
  }
</style>
