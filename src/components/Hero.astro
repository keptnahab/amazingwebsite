---
import hero01 from "../assets/hero/01-samsung-booth-ces.jpg";
import hero02 from "../assets/hero/02-sony-booth-ifa.jpg";
import hero03 from "../assets/hero/03-audi-a5-reveal-china.jpg";
import hero04 from "../assets/hero/04-brandner-kasper.jpg";
import hero05 from "../assets/hero/05-romeo-and-juliet.jpg";
import hero06 from "../assets/hero/06-romeo-and-juliet-ii.jpg";
import hero07 from "../assets/hero/07-geist-der-weihnacht.jpg";
import hero08 from "../assets/hero/08-starmania.jpg";
import hero09 from "../assets/hero/09-musikhelden.jpg";
import hero10 from "../assets/hero/10-bavaria-sounds.jpg";
import hero11 from "../assets/hero/11-apache-tour.jpg";
import hero12 from "../assets/hero/12-klangwolke-linz.jpg";
import hero13 from "../assets/hero/13-audi-etron-clt.jpg";
import hero14 from "../assets/hero/14-circle-of-light.jpg";
import hero15 from "../assets/hero/15-arab-gulf-cup-kuwait.jpg";
import hero16 from "../assets/hero/16-asia-cup-doha.jpg";

// project · client come straight from the IntroSlider filenames
const slides = [
  { src: hero01.src, project: "Samsung Booth at CES",  client: "Freestate" },
  { src: hero02.src, project: "Sony Booth at IFA",      client: "Freestate" },
  { src: hero03.src, project: "Audi A5 Reveal China",   client: "Amir Vaziri" },
  { src: hero04.src, project: "Brandner Kasper",        client: "Charly Pauli" },
  { src: hero05.src, project: "Romeo and Juliet",       client: "Roland Greil" },
  { src: hero06.src, project: "Romeo and Juliet",       client: "Roland Greil" },
  { src: hero07.src, project: "Geist der Weihnacht",    client: "Festspielhaus Füssen" },
  { src: hero08.src, project: "Starmania",              client: "Roland Greil" },
  { src: hero09.src, project: "Musikhelden",            client: "Systemprovider" },
  { src: hero10.src, project: "Bavaria Sounds",         client: "Roland Greil" },
  { src: hero11.src, project: "Apache Tour",            client: "Roland Greil" },
  { src: hero12.src, project: "Klangwolke Linz",        client: "Roland Greil" },
  { src: hero13.src, project: "Audi e-tron CLT",        client: "Audi" },
  { src: hero14.src, project: "Circle of Light",        client: "Jerry Appelt" },
  { src: hero15.src, project: "Arab Gulf Cup Kuwait",   client: "Roland Greil" },
  { src: hero16.src, project: "Asia Cup Doha",          client: "Roland Greil" },
];

// testimonials — `teaser` is the short pull-quote shown by default; `text` is
// the curated short version from Site assets/testimonials short.rtf, revealed
// on "Read more" — name · role · organisation
const quotes = [
  { teaser: "You were a joy to work with, and a machine. Not many people could have stayed this focused for that long.", text: "Thank you! You were a joy to work with and a machine. Not many people could have stayed as focused as you did for that long and it was fun to get to know you.", name: "Terry Cook", role: "Partner / Principal Designer", org: "Woodroffe Basset Design" },
  { teaser: "A remarkable level of professionalism and dedication — and for persevering whenever challenges arose.", text: "I want to express our deepest appreciation and gratitude to each and every one of you. Thank you for believing in our vision, for showcasing a remarkable level of professionalism and dedication.", name: "Mahmoud Hamaky", role: "Executive Producer / Project Director", org: "Katara Studios" },
  { teaser: "Thank you so much for the beautiful lighting, as well as for your exceptional durability!", text: "Thank you so much for the beautiful lighting as well as for your exceptional durability!", name: "Malte Joergens", role: "Creative Director", org: "adhoc engineering" },
  { teaser: "Truly amazing lights, you did an awesome job!", text: "Truly amazing lights, you did an awesome job! Thank you!", name: "Kurt Pongratz", role: "TV Director", org: "ORF" },
  { teaser: "Thank you for your ambition, your professionalism, and the calm sovereignty you exude throughout the production.", text: "Thank you for your ambition, your professionalism and your calm and sovereignty that you exude throughout the production.", name: "Thomas Stammberger", role: "Director", org: "BR" },
  { teaser: "An essential partner at every stage of the process.", text: "Michael is an essential partner at all stages of our process, from the first designs, through detailing and development, to on-site direction and delivery.", name: "Adam Scott", role: "Founder", org: "Freestate London" },
  { teaser: "Wow, we would never have expected that. Simply amazing — your expertise and commitment made it all possible.", text: "Wow, we would never have expected that. Simply amazing. Your expertise and commitment has made this all possible.", name: "M. Flossmann", role: "Marketing Communication", org: "OCÉ Printing Systems" },
  { teaser: "Really crazy on the MA desk, and you have a hugely cool way of working!", text: "Thank you, this was awesome from your side. You're really crazy on the MA and you have a hugely cool way of working!", name: "Florian Ploder", role: "CEO", org: "PS Eventconsulting" },
  { teaser: "The lighting design delivered was amazing — a delight to work with, super professional, friendly, and very reliable.", text: "The lighting design you delivered was amazing! It was a delight to work with you – super professional, friendly and very reliable.", name: "Anna Rank", role: "Project Manager", org: "Hassell London" },
  { teaser: "A great eye for the whole, time and again earning the role of lighting director and programmer.", text: "His great eye for the whole qualified him many times to the role of a lighting director and programmer which he fulfilled always to everybody's content.", name: "Jogi Foerg", role: "Senior Key Account Manager", org: "PRG Germany" },
  { teaser: "Professional, touching, beautiful — despite the short time, an excellent job reaching people on-site and at home.", text: "Professional, touching, beautiful. We thank you very much for your great effort. Thank you for your professionalism. We will recommend you with full conviction!", name: "Felix Finkbeiner", role: "CEO", org: "Plant-for-the-Planet Foundation" },
  { teaser: "It has always been a pleasure to work with such a refreshing approach to the entertainment design process.", text: "It has always been a pleasure to work with Mr. Kuehbandner's refreshing approach to the entertainment design process.", name: "Patrick Dierson", role: "President", org: "Dierson Design Group" },
  { teaser: "Deeply grateful for the knowledge shared in an entertaining and professionally unique manner.", text: "We are deeply grateful for the knowledge you shared in an equally entertaining and professionally unique manner and can only recommend Michael and his work to other companies.", name: "Hudson Barnes", role: "President", org: "JSAV Mexico and the Caribbean" },
];

const metaOf = (role, org) => (role ? `${role} · ${org}` : org);
// only worth a "Read more" toggle when the curated short text actually adds
// meaningfully more than the teaser — a trailing "Thank you!" doesn't count
quotes.forEach((q) => { q.hasMore = q.text.length > q.teaser.length * 1.35; });
---

<section class="hero" id="top">
  <div class="stage" aria-hidden="true">
    {slides.map((s, i) => (
      <img
        src={s.src}
        alt=""
        class:list={["slide", { active: i === 0 }]}
        data-i={i}
        style={`--focal:${s.focal ?? 50}%`}
        loading={i < 2 ? "eager" : "lazy"}
        decoding="async"
        fetchpriority={i === 0 ? "high" : "low"}
      />
    ))}
    <div class="scrim"></div>
  </div>

  <div class="wrap hero-bottom">
    <figure class="quote" id="quote">
      <blockquote id="qText">{quotes[0].teaser}</blockquote>
      <button class="q-more" id="qMore" type="button" hidden={!quotes[0].hasMore}>Read more</button>
      <figcaption id="qAttr">
        <span class="q-name">{quotes[0].name}</span>
        <span class="q-meta">{metaOf(quotes[0].role, quotes[0].org)}</span>
      </figcaption>
    </figure>
    <p class="credit" id="credit">
      <span class="credit-project">{slides[0].project}</span>
      <span class="credit-client">Client: {slides[0].client}</span>
    </p>
  </div>

  <a href="/#about" class="scroll-cue" aria-label="Scroll down">
    <span></span>
  </a>
</section>

<script
  define:vars={{ slides, quotes }}
>
  const imgs = [...document.querySelectorAll(".slide")];
  const credit = document.getElementById("credit");
  const qText = document.getElementById("qText");
  const qAttr = document.getElementById("qAttr");
  const quoteEl = document.getElementById("quote");
  const cue = document.querySelector(".scroll-cue");
  let qMore = document.getElementById("qMore");
  let si = 0;
  let qi = 0;
  let expanded = false;
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const isMobile = () => window.matchMedia("(max-width: 760px)").matches;

  function renderQuoteBody(q) {
    // mobile only ever shows the short teaser — no read-more there
    qText.textContent = expanded && q.hasMore && !isMobile() ? q.text : q.teaser;
    qMore.hidden = !q.hasMore;
    qMore.textContent = expanded ? "Show less" : "Read more";
  }

  // match the quote column's width to the header logo lockup (desktop only) —
  // on mobile the quote stacks full-width above/below the credit instead
  function syncQuoteWidth() {
    if (isMobile()) {
      if (quoteEl) quoteEl.style.width = "";
      if (expanded) { expanded = false; renderQuoteBody(quotes[qi]); }
      return;
    }
    const brand = document.querySelector(".site-header .brand");
    if (brand && quoteEl) quoteEl.style.width = `${brand.getBoundingClientRect().width}px`;
  }
  syncQuoteWidth();
  window.addEventListener("resize", syncQuoteWidth);
  window.addEventListener("load", syncQuoteWidth);

  function showSlide(n) {
    const prev = si;
    si = (n + slides.length) % slides.length;
    if (prev !== si) {
      // removing .active cancels the running animation (kenburns on desktop,
      // heropan on mobile), which snaps transform/object-position back to
      // their base values with no transition (animations don't hand off to
      // transitions on removal). Freeze the current mid-animation values as
      // inline styles first, then release them a frame later so the existing
      // transitions ease back down instead of jumping.
      const prevEl = imgs[prev];
      const cs = getComputedStyle(prevEl);
      const frozenTransform = cs.transform;
      const frozenObjectPosition = cs.objectPosition;
      prevEl.classList.remove("active");
      prevEl.style.transform = frozenTransform;
      prevEl.style.objectPosition = frozenObjectPosition;
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          prevEl.style.transform = "";
          prevEl.style.objectPosition = "";
        });
      });
    }
    imgs[si].classList.add("active");
    const s = slides[si];
    credit.innerHTML = `<span class="credit-project">${s.project}</span><span class="credit-client">Client: ${s.client}</span>`;
  }
  function showQuote(n) {
    qi = (n + quotes.length) % quotes.length;
    expanded = false;
    quoteEl.classList.add("fade");
    setTimeout(() => {
      const q = quotes[qi];
      renderQuoteBody(q);
      const meta = q.role ? `${q.role} · ${q.org}` : q.org;
      qAttr.innerHTML = `<span class="q-name">${q.name}</span><span class="q-meta">${meta}</span>`;
      quoteEl.classList.remove("fade");
    }, 1200);
  }

  if (qMore) qMore.addEventListener("click", () => {
    if (isMobile()) return; // no read-more interaction on mobile
    expanded = !expanded;
    renderQuoteBody(quotes[qi]);
  });

  if (cue) {
    window.addEventListener("scroll", () => {
      if (!isMobile()) return;
      cue.style.opacity = window.scrollY > 40 ? "0" : "1";
    }, { passive: true });
  }

  if (!reduce) {
    if (isMobile()) {
      // mobile: most slides load lazily anyway, don't gate the whole
      // rotation on decoding all 16 up front — start right away
      setInterval(() => showSlide(si + 1), 8500);
    } else {
      // desktop: wait for every (eager-loaded) slide to decode so the very
      // first cycle never shows a half-loaded frame
      Promise.allSettled(imgs.map((im) => im.decode ? im.decode() : Promise.resolve())).then(() => {
        setInterval(() => showSlide(si + 1), 8500);
      });
    }
    setInterval(() => showQuote(qi + 1), 10000);
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
  }
  .stage { position: absolute; inset: 0; z-index: 0; background: #000; }
  .slide {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.06);
    object-position: 50% center;
    transition: opacity 4.5s ease-in-out, transform 4.5s ease-in-out, object-position 4.5s ease-in-out;
  }
  .slide.active {
    opacity: 1;
    animation: kenburns 26s linear forwards;
  }
  @keyframes kenburns {
    from { transform: scale(1.06); }
    to   { transform: scale(1.14); }
  }
  .scrim {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(10,10,12,0.6) 0%, rgba(10,10,12,0) 26%),
      linear-gradient(0deg, rgba(10,10,12,0.96) 0%, rgba(10,10,12,0.78) 26%, rgba(10,10,12,0.32) 52%, rgba(10,10,12,0) 78%);
  }

  .hero-bottom {
    position: absolute; left: 0; right: 0; bottom: 0; z-index: 2;
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: 2rem;
    padding-bottom: 1.8rem;
  }
  .quote { margin: 0; width: 16em; max-width: 60vw; flex: none; }
  .quote blockquote {
    margin: 0;
    font-size: clamp(1.4rem, 2.6vw, 2.15rem);
    font-weight: 600;
    line-height: 1.18;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .quote blockquote::before { content: "“"; color: var(--muted-2); margin-right: 0.05em; }
  .quote blockquote::after { content: "”"; color: var(--muted-2); }
  .q-more {
    display: block; margin: 0.6rem 0 0; padding: 0;
    background: none; border: 0; cursor: pointer;
    font-size: 0.78rem; font-weight: 600; letter-spacing: 0.04em;
    color: var(--muted-2); text-decoration: underline;
    text-underline-offset: 2px;
  }
  .q-more:hover { color: var(--text); }
  .quote figcaption {
    display: flex; flex-direction: column; gap: 0.1rem;
    margin-top: 1.2rem;
  }
  /* :global — q-name/q-meta are rewritten via innerHTML on every quote
     rotation, so they never carry Astro's scoped data-cid attribute; a
     plain scoped rule would only style the first (SSR-rendered) quote */
  :global(.q-name) { font-weight: 600; font-size: 0.98rem; }
  :global(.q-meta) { color: var(--muted-2); font-size: 0.85rem; letter-spacing: 0.02em; }
  .quote { transition: opacity 1.3s ease-in-out; }
  .quote.fade { opacity: 0; }

  .credit {
    margin: 0; flex: none;
    display: flex; flex-direction: column; gap: 0.1rem;
    letter-spacing: 0.03em; text-align: right;
  }
  /* :global — same reason: credit-project/-client are rewritten via
     innerHTML on every slide change */
  :global(.credit-project) { color: var(--text); font-weight: 600; font-size: 0.98rem; }
  :global(.credit-client) { color: var(--muted-2); font-size: 0.85rem; letter-spacing: 0.02em; }

  .scroll-cue {
    position: absolute; left: 50%; bottom: 1.5rem; z-index: 2;
    transform: translateX(-50%);
    width: 22px; height: 34px; border: 1px solid rgba(255,255,255,0.4);
    border-radius: 12px; display: none;
    transition: opacity 0.3s var(--ease);
  }
  .scroll-cue span {
    position: absolute; left: 50%; top: 7px; width: 3px; height: 7px;
    background: #fff; border-radius: 2px; transform: translateX(-50%);
    animation: cue 1.8s var(--ease) infinite;
  }
  @keyframes cue { 0%{opacity:0;transform:translate(-50%,0)} 30%{opacity:1} 100%{opacity:0;transform:translate(-50%,10px)} }

  @media (min-width: 900px) { .scroll-cue { display: block; } }
  @media (prefers-reduced-motion: reduce) {
    .slide.active { animation: none; }
    .scroll-cue span { animation: none; }
  }

  /* ---- mobile (<=760px): full-bleed focal pan instead of Ken Burns,
     credit stacked above a shorter teaser-only quote, deeper scrim ---- */
  @media (max-width: 760px) {
    .scrim {
      background:
        linear-gradient(180deg, rgba(10,10,12,0.7) 0%, rgba(10,10,12,0) 22%),
        linear-gradient(0deg, rgba(10,10,12,0.98) 0%, rgba(10,10,12,0.86) 30%, rgba(10,10,12,0.42) 58%, rgba(10,10,12,0) 80%);
    }

    .slide.active {
      animation: heropan 8.5s ease-in-out infinite alternate;
    }
    @keyframes heropan {
      from { object-position: calc(var(--focal, 50%) - 7%) center; transform: scale(1.04); }
      to   { object-position: calc(var(--focal, 50%) + 7%) center; transform: scale(1.04); }
    }

    .hero-bottom {
      flex-direction: column;
      align-items: stretch;
      gap: 0.9rem;
    }
    .quote { order: 2; width: auto; max-width: 100%; }
    .credit {
      order: 1;
      flex-direction: row; flex-wrap: wrap;
      column-gap: 0.5rem;
      text-align: left;
    }
    /* :global — the credit spans are rewritten via innerHTML on every slide
       change, so they never carry Astro's scoped data-cid attribute and a
       plain scoped ::before would silently stop matching after rotation 1 */
    :global(.credit-client)::before { content: "· "; }
    .q-more { display: none !important; }

    .quote blockquote { font-size: clamp(1.1rem, 4.8vw, 1.4rem); line-height: 1.26; }
    :global(.q-name) { font-size: 0.9rem; }
    :global(.q-meta) { font-size: 0.78rem; }
    :global(.credit-project) { font-size: 0.9rem; }
    :global(.credit-client) { font-size: 0.78rem; }

    .scroll-cue { display: block; bottom: 1.2rem; }
  }
  @media (max-width: 760px) and (prefers-reduced-motion: reduce) {
    .slide.active { animation: none; }
  }
</style>
