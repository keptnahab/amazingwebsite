---
import "../styles/global.css";
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "amazinglighting.design — Michael Kühbandner · Lighting Design",
  description = "Lighting design, programming and previsualization for broadcast, concerts, ceremonies, corporate and theatre. 30+ years, worldwide.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // stop the browser from restoring the previous scroll position on
      // reload — without this, reloading mid-scroll re-lands you wherever
      // you last were (e.g. "About") instead of the top. URL-hash anchors
      // (e.g. /#about from a nav link) still scroll there as expected.
      if ("scrollRestoration" in history) history.scrollRestoration = "manual";
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0c" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Prototype: Manrope via Google Fonts. Production → self-hosted (@fontsource). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />

    <script>
      // reveal-on-scroll
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));

      // scroll-wake "spotlight" — touch devices have no :hover, so the
      // element nearest the screen's vertical center auto-gets the same
      // payoff a desktop hover would give it (image zoom, octagon rotate,
      // portrait desaturate, etc.), one at a time as you scroll. Harmless
      // on desktop since the .live styling only applies under mobile
      // media queries in each component's CSS.
      const spotlight = new IntersectionObserver(
        (entries) => {
          for (const e of entries) e.target.classList.toggle("live", e.isIntersecting);
        },
        { rootMargin: "-40% 0px -40% 0px" }
      );
      document.querySelectorAll("[data-spotlight]").forEach((el) => spotlight.observe(el));
    </script>
  </body>
</html>
