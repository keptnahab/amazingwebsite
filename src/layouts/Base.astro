---
import "../styles/global.css";
import "@fontsource/manrope/400.css";
import "@fontsource/manrope/500.css";
import "@fontsource/manrope/600.css";
import "@fontsource/manrope/700.css";
import "@fontsource/manrope/800.css";
import { locale, t, domains, otherLocale } from "../i18n/config";

interface Props {
  title?: string;
  description?: string;
}
const { title = t.meta.title, description = t.meta.description } = Astro.props;

const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const alternateUrl = (loc: typeof locale) => `https://${loc === "de" ? "www." : ""}${domains[loc]}${path}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // stop the browser from restoring the previous scroll position on
      // reload — without this, reloading mid-scroll re-lands you wherever
      // you last were (e.g. "About") instead of the top. URL-hash anchors
      // (e.g. /#about from a nav link) still scroll there as expected.
      if ("scrollRestoration" in history) history.scrollRestoration = "manual";
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0c" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang="en" href={alternateUrl("en")} />
    <link rel="alternate" hreflang="de" href={alternateUrl("de")} />
    <link rel="alternate" hreflang="x-default" href={alternateUrl("en")} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={locale === "de" ? "de_DE" : "en_US"} />
    <meta property="og:locale:alternate" content={otherLocale === "de" ? "de_DE" : "en_US"} />

    <!-- GoatCounter — cookie-free pageview analytics, no consent banner required
         (Art. 6 Abs. 1 lit. f DSGVO). One shared property across both locales. -->
    <script
      data-goatcounter="https://amazinglighting.goatcounter.com/count"
      async
      src="//gc.zgo.at/count.js"
    ></script>
  </head>
  <body>
    <slot />

    <script>
      // reveal-on-scroll
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));

      // scroll-wake "spotlight" — touch devices have no :hover, so the
      // element nearest the screen's vertical center auto-gets the same
      // payoff a desktop hover would give it (image zoom, octagon rotate,
      // portrait desaturate, etc.), one at a time as you scroll. Harmless
      // on desktop since the .live styling only applies under mobile
      // media queries in each component's CSS.
      const spotlight = new IntersectionObserver(
        (entries) => {
          for (const e of entries) e.target.classList.toggle("live", e.isIntersecting);
        },
        { rootMargin: "-40% 0px -40% 0px" }
      );
      document.querySelectorAll("[data-spotlight]").forEach((el) => spotlight.observe(el));
    </script>
  </body>
</html>
