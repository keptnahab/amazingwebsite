---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { locale, t } from "../i18n/config";
---

<Base title={t.meta.privacyTitle}>
  <Header />
  <main class="section">
    <div class="wrap legal">
      <p class="eyebrow">{t.legal.eyebrow}</p>
      <h1 class="section-title">{t.legal.privacyTitle}</h1>
      <hr class="rule" />

      {locale === "de" ? (
        <>
          <h2>1. Verantwortlicher</h2>
          <p>
            M. Kuehbandner<br />
            E-Mail: <a class="js-email legal-email" data-u="info" data-d="tolleslicht.de" href="#" set:html={"info&#64;tolleslicht.de"}></a>
          </p>

          <h2>2. Hosting</h2>
          <p>
            Diese Website wird bei STRATO AG, Pascalstraße 10, 10587 Berlin, gehostet. Die
            Verarbeitung erfolgt ausschließlich zum Zweck der zuverlässigen und sicheren
            Bereitstellung dieses Internetauftritts (Art. 6 Abs. 1 lit. f DSGVO).
          </p>

          <h2>3. Server-Logfiles</h2>
          <p>
            Beim Aufruf dieser Website erhebt der Hosting-Provider automatisch Informationen in
            sogenannten Server-Logfiles (z. B. IP-Adresse, Datum und Uhrzeit der Anfrage,
            aufgerufene Seite, Browsertyp). Diese Daten dienen ausschließlich dem sicheren und
            störungsfreien Betrieb der Website und werden nicht mit anderen Datenquellen
            zusammengeführt.
          </p>

          <h2>4. Cookies</h2>
          <p>
            Diese Website setzt keine eigenen Cookies. Der Webanalyse-Dienst Statcounter
            (siehe Abschnitt 5) verwendet ein technisches Cookie zur Unterscheidung von
            Einzel- und Mehrfachbesuchen. Die eingebundene Schriftart (Manrope) ist selbst
            gehostet — es findet keine Verbindung zu Google Fonts oder anderen externen
            Schrift-Servern statt.
          </p>

          <h2>5. Reichweitenmessung (Statcounter)</h2>
          <p>
            Diese Website nutzt den Webanalyse-Dienst Statcounter (StatCounter, South Hill,
            Delbrook Manor, Kiltipper Road, Dublin 24, Irland) zur Auswertung von
            Seitenaufrufen. Dabei wird ein Cookie gesetzt, das zur Unterscheidung von
            Einzel- und Mehrfachbesuchen dient. Statcounter erfasst anonymisierte Nutzungsdaten
            wie aufgerufene Seiten, Referrer, Browsertyp, Betriebssystem und
            Bildschirmauflösung; vollständige IP-Adressen werden nicht dauerhaft gespeichert.
            Die Daten werden auf Servern in Irland (EU) verarbeitet. Rechtsgrundlage ist
            Art. 6 Abs. 1 lit. f DSGVO (berechtigtes Interesse an einer
            datenschutzkonformen Reichweitenmessung). Weitere Informationen:{" "}
            <a href="https://statcounter.com/about/legal/" target="_blank" rel="noopener noreferrer">
              statcounter.com/about/legal
            </a>.
          </p>

          <h2>6. Kontaktaufnahme per E-Mail</h2>
          <p>
            Wenn Sie per E-Mail Kontakt aufnehmen, werden Ihre Angaben zur Bearbeitung der
            Anfrage gespeichert (Art. 6 Abs. 1 lit. b DSGVO). Die Daten werden gelöscht, sobald
            sie für die Bearbeitung nicht mehr erforderlich sind.
          </p>

          <h2>7. Ihre Rechte</h2>
          <p>
            Sie haben das Recht auf Auskunft, Berichtigung, Löschung, Einschränkung der
            Verarbeitung, Datenübertragbarkeit sowie Widerspruch gegen die Verarbeitung Ihrer
            personenbezogenen Daten. Wenden Sie sich hierzu an die oben genannte Kontaktadresse.
            Außerdem besteht ein Beschwerderecht bei einer Datenschutz-Aufsichtsbehörde.
          </p>
        </>
      ) : (
        <>
          <h2>1. Controller</h2>
          <p>
            M. Kuehbandner<br />
            E-Mail: <a class="js-email legal-email" data-u="info" data-d="amazinglighting.design" href="#" set:html={"info&#64;amazinglighting.design"}></a>
          </p>

          <h2>2. Hosting</h2>
          <p>
            This website is hosted by STRATO AG, Pascalstraße 10, 10587 Berlin, Germany.
            Processing is carried out solely for the purpose of providing this website reliably
            and securely (Art. 6(1)(f) GDPR).
          </p>

          <h2>3. Server Log Files</h2>
          <p>
            The hosting provider automatically collects information in server log files when
            you visit this website (e.g. IP address, date and time of the request, page
            accessed, browser type). This data is used solely to ensure the secure and
            uninterrupted operation of the website and is not merged with other data sources.
          </p>

          <h2>4. Cookies</h2>
          <p>
            This website does not set any cookies of its own. The analytics service Statcounter
            (see section 5) uses a technical cookie to distinguish unique from returning
            visitors. The typeface used (Manrope) is self-hosted — no connection is made to
            Google Fonts or any other external font server.
          </p>

          <h2>5. Analytics (Statcounter)</h2>
          <p>
            This website uses Statcounter (StatCounter, South Hill, Delbrook Manor, Kiltipper
            Road, Dublin 24, Ireland) to analyse page views. A cookie is set to distinguish
            unique from returning visits. Statcounter collects anonymised usage data such as
            pages visited, referrer, browser type, operating system and screen resolution;
            full IP addresses are not stored permanently. Data is processed on servers in
            Ireland (EU). The legal basis is Art. 6(1)(f) GDPR (legitimate interest in
            privacy-compliant web analytics). Further information:{" "}
            <a href="https://statcounter.com/about/legal/" target="_blank" rel="noopener noreferrer">
              statcounter.com/about/legal
            </a>.
          </p>

          <h2>6. Contact by E-Mail</h2>
          <p>
            If you contact us by e-mail, the information you provide will be stored for the
            purpose of processing your enquiry (Art. 6(1)(b) GDPR). The data will be deleted
            once it is no longer required for that purpose.
          </p>

          <h2>7. Your Rights</h2>
          <p>
            You have the right to access, rectification, erasure, restriction of processing,
            data portability and the right to object to the processing of your personal data.
            Please contact the address above to exercise these rights. You also have the right
            to lodge a complaint with a data protection supervisory authority.
          </p>
        </>
      )}
    </div>
  </main>
  <Footer />
</Base>

<script>
  document.querySelectorAll('a.js-email').forEach(a => {
    const el = a as HTMLAnchorElement & { dataset: { u?: string; d?: string } };
    el.href = 'mailto:' + el.dataset.u + '@' + el.dataset.d;
  });
</script>

<style>
  .legal { max-width: 70ch; }
  .legal p { color: var(--muted); margin: 1rem 0; }
  .legal h2 { font-size: 1.1rem; margin: 2rem 0 0.4rem; }
  .legal-email { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
</style>
