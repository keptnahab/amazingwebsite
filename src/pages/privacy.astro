---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { locale, t } from "../i18n/config";
---

<Base title={t.meta.privacyTitle}>
  <Header />
  <main class="section">
    <div class="wrap legal">
      <p class="eyebrow">{t.legal.eyebrow}</p>
      <h1 class="section-title">{t.legal.privacyTitle}</h1>
      <hr class="rule" />

      {locale === "de" ? (
        <>
          <h2>1. Verantwortlicher</h2>
          <p>
            M. Kuehbandner<br />
            Lochhauser Str. 82, 82178 Puchheim, Deutschland<br />
            E-Mail: info@tolleslicht.de
          </p>

          <h2>2. Hosting</h2>
          <p>
            Diese Website wird bei STRATO AG, Pascalstraße 10, 10587 Berlin, gehostet. Die
            Verarbeitung erfolgt ausschließlich zum Zweck der zuverlässigen und sicheren
            Bereitstellung dieses Internetauftritts (Art. 6 Abs. 1 lit. f DSGVO).
          </p>

          <h2>3. Server-Logfiles</h2>
          <p>
            Beim Aufruf dieser Website erhebt der Hosting-Provider automatisch Informationen in
            sogenannten Server-Logfiles (z. B. IP-Adresse, Datum und Uhrzeit der Anfrage,
            aufgerufene Seite, Browsertyp). Diese Daten dienen ausschließlich dem sicheren und
            störungsfreien Betrieb der Website und werden nicht mit anderen Datenquellen
            zusammengeführt.
          </p>

          <h2>4. Keine Cookies</h2>
          <p>
            Diese Website ist eine rein statische Seite. Es werden keine Cookies gesetzt. Die
            eingebundene Schriftart ist selbst gehostet — es findet keine Verbindung zu
            Google Fonts oder anderen externen Schrift-Servern statt.
          </p>

          <h2>5. Reichweitenmessung (GoatCounter)</h2>
          <p>
            Diese Website nutzt den Webanalyse-Dienst GoatCounter (GoatCounter, Arnhem,
            Niederlande, Server in der EU) zur anonymen Auswertung von Seitenaufrufen — z. B.
            welche Unterseite wie oft besucht wurde und über welche Seite Besucher gekommen
            sind. GoatCounter setzt keine Cookies und speichert keine vollständige IP-Adresse
            oder andere personenbezogene Daten; eine Zuordnung zu einzelnen Besuchern ist nicht
            möglich. Rechtsgrundlage ist Art. 6 Abs. 1 lit. f DSGVO (berechtigtes Interesse an
            einer einfachen, datensparsamen Reichweitenmessung). Weitere Informationen:{" "}
            <a href="https://www.goatcounter.com/privacy" target="_blank" rel="noopener noreferrer">
              goatcounter.com/privacy
            </a>.
          </p>

          <h2>6. Kontaktaufnahme per E-Mail</h2>
          <p>
            Wenn Sie per E-Mail Kontakt aufnehmen, werden Ihre Angaben zur Bearbeitung der
            Anfrage gespeichert (Art. 6 Abs. 1 lit. b DSGVO). Die Daten werden gelöscht, sobald
            sie für die Bearbeitung nicht mehr erforderlich sind.
          </p>

          <h2>7. Ihre Rechte</h2>
          <p>
            Sie haben das Recht auf Auskunft, Berichtigung, Löschung, Einschränkung der
            Verarbeitung, Datenübertragbarkeit sowie Widerspruch gegen die Verarbeitung Ihrer
            personenbezogenen Daten. Wenden Sie sich hierzu an die oben genannte Kontaktadresse.
            Außerdem besteht ein Beschwerderecht bei einer Datenschutz-Aufsichtsbehörde.
          </p>
        </>
      ) : (
        <p>
          Placeholder — the full privacy policy will be added before launch. The site ships as
          a static page, sets no cookies, and self-hosts its fonts (no Google Fonts requests).
          Page views are measured anonymously via{" "}
          <a href="https://www.goatcounter.com/privacy" target="_blank" rel="noopener noreferrer">GoatCounter</a>,
          which stores no cookies and no full IP addresses or other personal data.
        </p>
      )}
    </div>
  </main>
  <Footer />
</Base>

<style>
  .legal { max-width: 70ch; }
  .legal p { color: var(--muted); margin: 1rem 0; }
  .legal h2 { font-size: 1.1rem; margin: 2rem 0 0.4rem; }
</style>
