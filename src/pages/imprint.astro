---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { locale, t } from "../i18n/config";
---

<Base title={t.meta.imprintTitle}>
  <Header />
  <main class="section">
    <div class="wrap legal">
      <p class="eyebrow">{t.legal.eyebrow}</p>
      <h1 class="section-title">{t.legal.imprintTitle}</h1>
      <hr class="rule" />

      {locale === "de" ? (
        <>
          <h2>Angaben gemäß § 5 DDG</h2>
          <p>
            M. Kuehbandner<br />
            Lochhauser Str. 82<br />
            82178 Puchheim, Deutschland
          </p>

          <h2>Kontakt</h2>
          <p>
            E-Mail: info@amazinglighting.design
          </p>

          <h2>Umsatzsteuer-ID</h2>
          <p>
            Umsatzsteuer-Identifikationsnummer gemäß §27a Umsatzsteuergesetz: DE174430529
          </p>

          <h2>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
          <p>
            Michael Kühbandner, Anschrift wie oben.
          </p>

          <h2>EU-Streitschlichtung</h2>
          <p>
            Die Europäische Kommission stellt eine Plattform zur Online-Streitbeilegung (OS) bereit:{" "}
            <a href="https://ec.europa.eu/consumers/odr/" target="_blank" rel="noopener noreferrer">https://ec.europa.eu/consumers/odr/</a>.
            Wir sind nicht verpflichtet und nicht bereit, an Streitbeilegungsverfahren vor einer
            Verbraucherschlichtungsstelle teilzunehmen.
          </p>

        </>
      ) : (
        <p>Michael Kühbandner · Munich, Germany · info@amazinglighting.design</p>
      )}
    </div>
  </main>
  <Footer />
</Base>

<style>
  .legal { max-width: 70ch; }
  .legal p { color: var(--muted); margin: 1rem 0; }
  .legal h2 { font-size: 1.1rem; margin: 2rem 0 0.4rem; }
  .legal .note { font-size: 0.85rem; font-style: italic; }
</style>
