---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Base title="Imprint — amazinglighting.design">
  <Header />
  <main class="section">
    <div class="wrap legal">
      <p class="eyebrow">Legal</p>
      <h1 class="section-title">Imprint</h1>
      <hr class="rule" />
      <p>Placeholder — required legal details (Impressum) will be added before launch, especially for the German tolleslicht.de version (§5 DDG / §18 MStV).</p>
      <p>Michael Kühbandner · Munich, Germany · info@amazinglighting.design</p>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .legal { max-width: 70ch; }
  .legal p { color: var(--muted); margin: 1rem 0; }
</style>
